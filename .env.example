# Supabase (public — safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — server-only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (public key is safe to expose; secret key is server-only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email via SMTP (Nodemailer — contact form)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=

# Email via Resend (order confirmations)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Site URL (used for Stripe return_url)
NEXT_PUBLIC_SITE_URL=
